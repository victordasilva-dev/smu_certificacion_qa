/**
 * B2C-41 — Carro: modal de sugeridos "¡Que no se te olviden!" al continuar con la entrega.
 *
 * Precondición común: sesión con la cuenta que declara cada TC, el carro con {SKU_VALID_001} ×
 * {UNIDADES_SOBRE_MINIMO} (subtotal ≥ {MONTO_MINIMO_COMPRA}) y un método de entrega activo. El
 * carro se arma en cada test() solo si no está como se pide.
 *
 * Una sesión por cuenta en `.qa/auth/b41-<alias>.json` (no se commitea): se reutiliza entre casos y
 * motores; si venció, se vuelve a entrar con correo + OTP.
 *
 * El modal trae además la pestaña "Imperdibles" (B2C-308), fuera del alcance de B2C-41 y primera
 * seleccionada al abrir: los casos de pestañas validan las dos de B2C-41 y su orden, y lo anotan.
 *
 * Sin `test()`: D/M-007 (la cuenta de data no tiene más de 24 My Usuals) y D/M-011
 * ({ADD_TO_CART_API_ENDPOINT} en TBD en el Excel de data).
 */

type Cuenta = 'COMPRADOR_USUALS_FAVORITOS_USER' | 'COMPRADOR_SIN_SUGERENCIAS_USER' | 'COMPRADOR_SOLO_USUALS_USER' | 'COMPRADOR_SOLO_FAVORITOS_USER';

function correo(testData: LoadedTestData, cuenta: Cuenta): string {
  return token(testData, cuenta)!.split('/')[0].trim();
}

function sesionDe(email: string): string {
  const alias = (email.split('@')[0].split('+')[1] ?? email.split('@')[0]).replace(/\W+/g, '');
  return path.resolve(`.qa/auth/b41-${alias}.json`);
}

/** Inicia sesión reutilizando el storageState de la cuenta; si no sirve, por correo + OTP. */
async function iniciarSesion(page: Page, testData: LoadedTestData, cuenta: Cuenta): Promise<void> {
  const email = correo(testData, cuenta);
  const SESION = sesionDe(email);
  if (fs.existsSync(SESION)) {
    const estado = JSON.parse(fs.readFileSync(SESION, 'utf-8'));
    await page.context().addCookies(estado.cookies ?? []);
    const origen = (estado.origins ?? [])[0];
    if (origen?.localStorage?.length) {
      await page.addInitScript((items: { name: string; value: string }[]) => {
        if (sessionStorage.getItem('__b41_ls')) return;
        for (const { name, value } of items) localStorage.setItem(name, value);
        sessionStorage.setItem('__b41_ls', '1');
      }, origen.localStorage);
    }
  }
  const home = await new PaginaHabilitada(page).goto();
  await home.cookies.aceptarSiAparece();
  const login = new LoginModal(page);
  const conSesion = await home.header.saludo.waitFor({ state: 'visible', timeout: 20000 }).then(() => true, () => false);
  if (!conSesion) {
    const desde = marcaOtp();
    await login.pedirCodigo(email);
    await login.ingresarCodigo(await esperarOtp(email, desde, { digitos: 6 }));
    fs.mkdirSync(path.dirname(SESION), { recursive: true });
    await page.context().storageState({ path: SESION });
  }
  await login.descartarPasskey();
}

/** Deja el carro con exactamente {SKU_VALID_001} × {UNIDADES_SOBRE_MINIMO}; lo vacía si trae otra cosa. */
async function asegurarCarro(page: Page, testData: LoadedTestData): Promise<CarroPage> {
  const unidades = Number(token(testData, 'UNIDADES_SOBRE_MINIMO'));
  let carro = await new CarroPage(page).goto();
  await expect(carro.carroVacio.or(carro.totalUnidades)).toBeVisible({ timeout: 30000 });
  if (!(await carro.carroVacio.isVisible())) {
    const n = Number((((await carro.totalUnidades.textContent()) ?? '').match(/\d+/) ?? ['0'])[0]);
    if ((await carro.productos()).length !== 1 || n < 1) {
      await carro.vaciar();
    }
  }
  if (await carro.carroVacio.isVisible()) {
    const pdp = await new PDPPage(page).abrir(token(testData, 'SKU_VALID_001')!);
    await pdp.agregarVisible.click();
    const sinMetodo = page.getByRole('dialog').filter({ hasText: /elige tu m[ée]todo de entrega/i });
    if (await sinMetodo.waitFor({ state: 'visible', timeout: 4000 }).then(() => true, () => false)) {
      throw new Error('PRECONDICION: la cuenta no tiene un método de entrega activo (el sitio pide elegir uno al agregar).');
    }
    await expect(pdp.cantidadEnCarro).toBeVisible({ timeout: 15000 });
    carro = await new CarroPage(page).goto();
    await expect(carro.totalUnidades).toBeVisible({ timeout: 30000 });
  }
  for (let i = 0; i < 30; i++) {
    const n = Number(((await carro.totalUnidades.textContent()) ?? '').match(/\d+/)![0]);
    if (n === unidades) break;
    await (n < unidades ? carro.botonSumar : carro.botonRestar).click();
    await expect(carro.totalUnidades).not.toHaveText(new RegExp(`^${n} `), { timeout: 15000 });
  }
  await expect(carro.totalUnidades, 'unidades del SKU en el carro').toHaveText(`${unidades} unidades`);
  return carro;
}

/** Precondición + pasos 1–2: sesión, carro armado y cargado en {CART_URL}. */
async function hastaElCarro(page: Page, testData: LoadedTestData, cuenta: Cuenta, cp: string): Promise<CarroPage> {
  await iniciarSesion(page, testData, cuenta);
  await asegurarCarro(page, testData);
  const carro = await new CarroPage(page).goto();
  await page.waitForLoadState('networkidle', { timeout: 15000 }).catch(() => {});
  await expect(carro.titulo).toBeVisible({ timeout: 30000 });
  await expect(carro.totalUnidades).toHaveText(`${token(testData, 'UNIDADES_SOBRE_MINIMO')} unidades`);
  expect(Number(((await carro.subtotal.textContent()) ?? '').replace(/\D/g, '')), 'subtotal ≥ mínimo de compra').toBeGreaterThanOrEqual(
    Number(token(testData, 'MONTO_MINIMO_COMPRA')),
  );
  await carro.capturarEvidencia(cp, 2, 'carro cargado');
  return carro;
}

/** Pasos 1–4: carro → "Continuar con la entrega" → modal de sugeridos abierto. */
async function hastaElModal(page: Page, testData: LoadedTestData, cuenta: Cuenta, cp: string) {
  const carro = await hastaElCarro(page, testData, cuenta, cp);
  await carro.botonContinuarEntrega.click();
  const modal = new SugeridosModal(page);
  await expect(modal.root, 'modal "¡Que no se te olviden!"').toBeVisible({ timeout: 30000 });
  await expect(modal.botonesFavorito.first()).toBeVisible({ timeout: 30000 });
  await carro.capturarEvidencia(cp, 4, 'modal de sugeridos abierto');
  return { carro, modal };
}

test.describe('B2C-41 — Carro: modal de sugeridos', () => {
