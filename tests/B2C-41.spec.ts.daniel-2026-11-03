  for (const [ff, vp, sufijo, L] of [
    ['Desktop 1440x900', DESKTOP, 'Desktop', 'D'],
    ['Mobile 390x844', MOBILE, 'Mobile', 'M'],
  ] as const) {
    test.describe(ff, () => {
      test.use(vp);

      test(`TC-B2C41-${L}-001 · Continuar con la entrega abre el modal de sugeridos cuando hay sugerencias [Logueado] (${sufijo})`, async ({ page, testData }) => {
        const cp = `TC-B2C41-${L}-001`;
        const { modal } = await hastaElModal(page, testData, 'COMPRADOR_USUALS_FAVORITOS_USER', cp);
        await expect(modal.root.getByText(/¡que no se te olviden!/i).first()).toBeVisible();
        await expect(modal.continuar).toBeVisible();
        await modal.cerrar.waitFor({ state: 'visible' });
        await new CarroPage(page).capturarEvidencia(cp);
      });

      test(`TC-B2C41-${L}-002 · Sin sugerencias el modal no se muestra y el flujo continúa [Logueado] (${sufijo})`, async ({ page, testData }) => {
        const cp = `TC-B2C41-${L}-002`;
        const carro = await hastaElCarro(page, testData, 'COMPRADOR_SIN_SUGERENCIAS_USER', cp);
        await carro.botonContinuarEntrega.click();
        const modal = new SugeridosModal(page);
        await page.waitForURL(/\/checkout\/entrega/, { timeout: 30000 });
        await expect(modal.root, 'el modal de sugeridos no se presenta').toBeHidden();
        await carro.capturarEvidencia(cp, 4, 'Mis Envíos sin modal');
        await carro.capturarEvidencia(cp);
      });

      test(`TC-B2C41-${L}-003 · Con My Usuals y favoritos se ven ambas pestañas en orden [Logueado] (${sufijo})`, async ({ page, testData }) => {
        const cp = `TC-B2C41-${L}-003`;
        const { carro, modal } = await hastaElModal(page, testData, 'COMPRADOR_USUALS_FAVORITOS_USER', cp);
        const nombres = await modal.nombresDePestanas();
        const iUsuals = nombres.findIndex((n) => /^lo que m[áa]s compro$/i.test(n));
        const iFavs = nombres.findIndex((n) => /^mis favoritos$/i.test(n));
        expect(iUsuals, `pestaña "Lo que más compro" en [${nombres.join(' | ')}]`).toBeGreaterThanOrEqual(0);
        expect(iFavs, `pestaña "Mis favoritos" en [${nombres.join(' | ')}]`).toBeGreaterThan(iUsuals);
        await modal.loQueMasCompro.click();
        await expect(modal.pestanaActiva, '"Lo que más compro" resaltada').toHaveText(/lo que m[áa]s compro/i);
        await expect(modal.botonesFavorito.first()).toBeVisible();
        await carro.capturarEvidencia(cp, 5, 'pestañas del modal con Lo que más compro resaltada');
        await carro.capturarEvidencia(cp);
      });

      test(`TC-B2C41-${L}-004 · Sin favoritos solo se ve la pestaña Lo que más compro [Logueado] (${sufijo})`, async ({ page, testData }) => {
        const cp = `TC-B2C41-${L}-004`;
        const { carro, modal } = await hastaElModal(page, testData, 'COMPRADOR_SOLO_USUALS_USER', cp);
        await expect(modal.loQueMasCompro, 'pestaña "Lo que más compro"').toBeVisible();
        await expect(modal.misFavoritos, 'no hay pestaña "Mis favoritos"').toHaveCount(0);
        await modal.loQueMasCompro.click();
        await expect(modal.pestanaActiva).toHaveText(/lo que m[áa]s compro/i);
        await carro.capturarEvidencia(cp, 5, 'solo la pestaña Lo que más compro');
        await carro.capturarEvidencia(cp);
      });

      test(`TC-B2C41-${L}-005 · Sin My Usuals solo se ve la pestaña Mis favoritos [Logueado] (${sufijo})`, async ({ page, testData }) => {
        const cp = `TC-B2C41-${L}-005`;
        const { carro, modal } = await hastaElModal(page, testData, 'COMPRADOR_SOLO_FAVORITOS_USER', cp);
        await expect(modal.misFavoritos, 'pestaña "Mis favoritos"').toBeVisible();
        await expect(modal.loQueMasCompro, 'no hay pestaña "Lo que más compro"').toHaveCount(0);
        await modal.misFavoritos.click();
        await expect(modal.pestanaActiva).toHaveText(/mis favoritos/i);
        await carro.capturarEvidencia(cp, 5, 'solo la pestaña Mis favoritos');
        await carro.capturarEvidencia(cp);
      });

      test(`TC-B2C41-${L}-006 · Lo que más compro muestra los My Usuals en grilla 2x2 con Continuar fijo [Logueado] (${sufijo})`, async ({ page, testData }) => {
        const cp = `TC-B2C41-${L}-006`;
        const { carro, modal } = await hastaElModal(page, testData, 'COMPRADOR_USUALS_FAVORITOS_USER', cp);
        await modal.loQueMasCompro.click();
        await expect(modal.pestanaActiva, '"Lo que más compro" resaltada').toHaveText(/lo que m[áa]s compro/i);
        await expect(modal.botonesFavorito.first()).toBeVisible();
        expect(await modal.cantidadDeTarjetas(), 'My Usuals mostrados').toBeGreaterThanOrEqual(2);
        expect((await modal.columnas()).length, 'columnas de la grilla').toBe(2);
        const primera = modal.tarjetas.first();
        await expect(primera.getByText(/\$\d/).first(), 'precio en la tarjeta').toBeVisible();
        await expect(primera.getByRole('button', { name: /(guardar en|quitar de) favoritos/i }), 'favorito en la tarjeta').toHaveCount(1);
        await expect(primera.getByRole('button', { name: /agregar|aumentar cantidad/i }).first(), '"Agregar" en la tarjeta').toBeVisible();
        const antes = await modal.continuar.boundingBox();
        await modal.desplazar(400);
        const despues = await modal.continuar.boundingBox();
        expect(despues?.y, '"Continuar" no se mueve').toBe(antes?.y);
        await carro.capturarEvidencia(cp, 5, 'Lo que más compro en grilla 2x2', { elemento: modal.root });
        await carro.capturarEvidencia(cp);
      });

      test(`TC-B2C41-${L}-008 · Mis favoritos muestra los favoritos en grilla 2x2 sin tope [Logueado] (${sufijo})`, async ({ page, testData }) => {
        const cp = `TC-B2C41-${L}-008`;
        const { carro, modal } = await hastaElModal(page, testData, 'COMPRADOR_USUALS_FAVORITOS_USER', cp);
        await modal.misFavoritos.click();
        await expect(modal.pestanaActiva, '"Mis favoritos" resaltada').toHaveText(/mis favoritos/i);
        await expect(modal.botonesFavorito.first()).toBeVisible();
        expect((await modal.columnas()).length, 'columnas de la grilla').toBe(2);
        await expect(modal.continuar).toBeVisible();
        const enModal = await modal.cantidadDeTarjetas();
        await carro.capturarEvidencia(cp, 6, 'Mis favoritos en grilla 2x2', { elemento: modal.root });
        const favoritos = await new MisFavoritosPage(page).goto();
        await favoritos.waitUntilReady();
        await page.waitForLoadState('networkidle', { timeout: 15000 }).catch(() => {});
        const enCuenta = await favoritos.cantidad();
        expect(enCuenta, 'favoritos de la cuenta').toBeGreaterThan(0);
        expect(enModal, 'la pestaña muestra todos los favoritos de la cuenta, sin tope').toBe(enCuenta);
        await favoritos.capturarEvidencia(cp);
      });

      test(`TC-B2C41-${L}-009 · Agregar un sugerido lo suma al carro y el modal sigue abierto [Logueado] (${sufijo})`, async ({ page, testData }) => {
        const cp = `TC-B2C41-${L}-009`;
        const { carro, modal } = await hastaElModal(page, testData, 'COMPRADOR_USUALS_FAVORITOS_USER', cp);
        await modal.loQueMasCompro.click();
        await expect(modal.primerAgregar).toBeVisible();
        const antes = Number((((await carro.totalUnidades.textContent()) ?? '').match(/\d+/) ?? ['0'])[0]);
        const tarjeta = modal.tarjetaDelPrimerAgregar;

        // Se frena la petición de escritura para poder ver el estado "procesando" de la tarjeta.
        let liberar: () => void = () => {};
        const frenada = new Promise<void>((r) => (liberar = r));
        await page.route(/\/(api|bff|cart|carts)\b/i, async (route) => {
          if (route.request().method() !== 'GET') await Promise.race([frenada, new Promise((r) => setTimeout(r, 4000))]);
          await route.continue().catch(() => {});
        });
        await modal.primerAgregar.click();
        const hayCarga = await modal.cargaEn(tarjeta).first().waitFor({ state: 'visible', timeout: 3000 }).then(() => true, () => false);
        await carro.capturarEvidencia(cp, 5, 'tarjeta mientras se procesa el Agregar', { elemento: modal.root });
        liberar();
        await page.unroute(/\/(api|bff|cart|carts)\b/i);

        await expect(modal.enCarro.first(), 'la tarjeta pasa a "En carro"').toBeVisible({ timeout: 20000 });
        await expect(carro.totalUnidades, 'contador del carro actualizado').toHaveText(`${antes + 1} unidades`, { timeout: 20000 });
        await expect(modal.root, 'el modal sigue abierto').toBeVisible();
        await expect(modal.continuar, '"Continuar" habilitado').toBeEnabled();
        await carro.capturarEvidencia(cp, 6, 'producto agregado y modal abierto', { elemento: modal.root });
        expect(hayCarga, 'se muestra un loading en la tarjeta mientras se procesa').toBe(true);
        await carro.capturarEvidencia(cp);
      });

      test(`TC-B2C41-${L}-010 · Continuar cierra el modal de sugeridos y sigue a Mis envíos [Logueado] (${sufijo})`, async ({ page, testData }) => {
        const cp = `TC-B2C41-${L}-010`;
        const { carro, modal } = await hastaElModal(page, testData, 'COMPRADOR_USUALS_FAVORITOS_USER', cp);
        await modal.continuar.click();
        await page.waitForURL(/\/checkout\/entrega/, { timeout: 30000 });
        await expect(modal.root, 'el modal se cierra').toBeHidden();
        await carro.capturarEvidencia(cp, 5, 'Mis Envíos tras Continuar');
        await carro.capturarEvidencia(cp);
      });
    });
  }

  test.describe('Mobile 390x844', () => {
    test.use(MOBILE);

    test('TC-B2C41-M-012 · Al hacer scroll en el modal el botón Continuar permanece fijo [Logueado] (Mobile)', async ({ page, testData }) => {
      const cp = 'TC-B2C41-M-012';
      const { carro, modal } = await hastaElModal(page, testData, 'COMPRADOR_USUALS_FAVORITOS_USER', cp);
      await modal.loQueMasCompro.click();
      await expect(modal.botonesFavorito.first()).toBeVisible();
      const primeraAntes = await modal.tarjetas.first().boundingBox();
      const continuarAntes = await modal.continuar.boundingBox();
      await modal.desplazar(2000);
      const primeraDespues = await modal.tarjetas.first().boundingBox();
      const continuarDespues = await modal.continuar.boundingBox();
      await carro.capturarEvidencia(cp, 5, 'modal desplazado hasta el final', { elemento: modal.root });
      expect(primeraDespues?.y, 'el área de productos se desplaza').not.toBe(primeraAntes?.y);
      await expect(modal.continuar, '"Continuar" visible tras el scroll').toBeVisible();
      expect(continuarDespues?.y, '"Continuar" permanece fijo').toBe(continuarAntes?.y);
      await carro.capturarEvidencia(cp);
    });
  });
});
