{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",

    "lib": ["ES2022", "DOM"],
    "types": ["node", "@playwright/test"],

    "strict": true,
    "noEmit": true,
    // tests-app/support/explorar.ts lo corre Node sin transpilar, y Node solo resuelve un import
    // relativo de TypeScript si trae la extensión. Permitido porque no se emite nada (noEmit).
    "allowImportingTsExtensions": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,

    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": [
    "tests/**/*.ts",
    "tests-app/**/*.ts",
    "playwright.config.ts",
    "playwright.config.ci.ts",
    "mobilewright.config.ts",
    "mobilewright.ios.config.ts"
  ],
  "exclude": [
    "node_modules",
    "playwright-report",
    "mobilewright-report",
    "test-results"
  ]
}
