# El ambiente (BASE_URL) ya NO se define aqui: es data de la suite, no configuracion de la
# maquina. Sale del token {BASE_URL} del Excel de data y lo deja `qa_excel.py read` en
# tests/data.json, que es lo que leen los tests. Definirlo en dos sitios los
# desincroniza en silencio y la suite termina certificando el ambiente equivocado.
# Para apuntar a otro ambiente en una corrida puntual, pasalo inline y gana sobre el archivo:
#   BASE_URL=https://otro-ambiente npx playwright test

# Carpeta con la planilla de Test Cases y el Excel de data (el "workspace QA").
# La skill qa-executor lee los TC y los tokens de aqui, y deja el Word de evidencia
# en la misma carpeta. Se puede sobrescribir indicando la ruta en el pedido.
QA_WORKSPACE_DIR=C:/Users/dasil/OneDrive/test_claude

# Ejecutar los tests con el navegador visible (true) o headless (false).
# La exploracion con playwright-cli siempre es headed; esto controla la Fase 7.
HEADED=true

# Motor de navegador por form-factor (chromium | firefox | webkit).
# El viewport NO se define aquí: lo fija cada TC (Desktop/Mobile) con test.use().
# MOBILE_BROWSER debe ser chromium o webkit (firefox no soporta isMobile).
DESKTOP_BROWSER=chromium
MOBILE_BROWSER=webkit

# --- App nativa (mobilewright) ---------------------------------------------------------------
# Los TC -APP- corren con mobilewright: iOS SIEMPRE en Mobile Next Cloud (en Windows no hay
# simulador de iOS) y Android en local (emulador o equipo por ADB) salvo ANDROID_EN_CLOUD=true.
# El bundle y el binario de la app NO van aqui: son data de la suite y salen del Excel de data
# ({IOS_BUNDLE_ID}, {IOS_APP_BUILD}, {ANDROID_PACKAGE}, {ANDROID_APP_BUILD}).

# Clave de Mobile Next Cloud (https://app.mobilenext.ai). Secreto de la maquina: nunca en el
# Excel, en el Word ni en Jira. Solo hace falta si la planilla tiene TC de app en iOS, o Android
# en la nube.
MOBILENEXT_API_KEY=

# Android en Mobile Next Cloud en vez del emulador/equipo local.
ANDROID_EN_CLOUD=false

# Filtro opcional de dispositivo. *_DEVICE_NAME es una regex sobre el nombre del modelo
# ("iPhone 1[56]", "Pixel"); *_OS_VERSION acepta "17" (cualquier 17.x), "26.0" o ">=17 <19".
# La regex no va anclada: "Pixel 8" tambien acepta un "Pixel 8a" o un "Pixel 8 Pro" (comprobado
# en Mobile Next Cloud). Para un modelo exacto, anclala: "Pixel 8$".
IOS_DEVICE_NAME=
IOS_OS_VERSION=
ANDROID_DEVICE_NAME=
ANDROID_OS_VERSION=

# Subir el reporte de cada corrida al dashboard de Mobile Next: on | on-failure | off.
MOBILENEXT_SUBIR_REPORTE=on

# Espera maxima por un dispositivo de la nube, en ms (vacio = 15 min). Corre con su propio reloj:
# no consume el timeout del caso.
APP_ALLOCATION_TIMEOUT=

# Animaciones del sistema en el dispositivo: on | off (vacio = no se tocan). `off` quita el fallo
# intermitente de Android "failed to dump UI ... uiautomator dump" en apps con splash o carruseles
# animados, pero cambia esa configuracion del emulador/equipo.
APP_ANIMACIONES=
