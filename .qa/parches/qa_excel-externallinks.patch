+# --------------------------------------------------------------------------- integridad del xlsx
+
+def repair_package(path):
+    """Repara lo que openpyxl rompe al reescribir un .xlsx, y verifica que quedo integro.
+
+    openpyxl no conserva bien dos cosas de un libro hecho en Excel, y las dos se manifiestan
+    igual para quien abre el archivo: el aviso de "encontramos un problema con parte del
+    contenido", que no distingue entre un detalle cosmetico y la perdida de una hoja entera.
+
+    1. **Las referencias externas quedan colgando.** Si el libro trae formulas contra otro
+       archivo, `xl/externalLinks/externalLinkN.xml` cita su destino por `r:id`, y openpyxl
+       reescribe el `.rels` de esa parte con un Id distinto del que la parte usa. La referencia
+       deja de resolver y Excel la reporta como contenido ilegible. Se alinea el Id al que la
+       parte realmente cita, que es la fuente fiable: el destino externo sigue siendo correcto,
+       lo que se perdio es la correspondencia entre los dos.
+    2. **Quedan partes `[trash]/NNNN.dat`** dentro del zip, sin declarar en `[Content_Types]`.
+       Son restos del libro original que openpyxl no supo reubicar. Excel las ignora, pero no
+       pertenecen al paquete y solo abultan el archivo.
+
+    La comprobacion final no es un lujo: el sintoma aparece al ABRIR el archivo, que es horas
+    despues y en la maquina de otra persona. Barre todas las partes buscando `r:id` sin
+    relacion declarada y devuelve lo que no pudo arreglar, para que quien corre la herramienta
+    se entere en el momento y no el dia de la entrega.
+
+    Devuelve (arreglos, pendientes): dos listas de texto listo para imprimir.
+    """
+    import posixpath
+    import zipfile
+
+    arreglos, pendientes = [], []
+    try:
+        src = zipfile.ZipFile(path)
+    except Exception as e:                                    # noqa: BLE001
+        return [], ["no pude revisar la integridad del .xlsx: %s" % e]
+
+    try:
+        items, cambiado = [], False
+        for info in src.infolist():
+            name = info.filename
+            if name.startswith("[trash]/"):
+                cambiado = True
+                arreglos.append("parte sobrante %s eliminada del paquete" % name)
+                continue
+            data = src.read(name)
+            m = re.match(r"xl/externalLinks/_rels/(externalLink\d+\.xml)\.rels$", name)
+            if m:
+                parte = "xl/externalLinks/" + m.group(1)
+                try:
+                    xml = src.read(parte).decode("utf-8")
+                except KeyError:
+                    items.append((info, data))
+                    continue
+                usa = re.search(r"externalBook[^>]*r:id=\"([^\"]+)\"", xml)
+                txt = data.decode("utf-8")
+                declarados = re.findall(r"Id=\"([^\"]+)\"", txt)
+                if usa and usa.group(1) not in declarados:
+                    txt = re.sub(r"Id=\"[^\"]+\"", "Id=\"%s\"" % usa.group(1), txt)
+                    data = txt.encode("utf-8")
+                    cambiado = True
+                    arreglos.append(
+                        "referencia externa de %s reapuntada a %s (openpyxl la dejo en %s)"
+                        % (m.group(1), usa.group(1), ", ".join(declarados) or "ninguna")
+                    )
+            items.append((info, data))
+
+        if cambiado:
+            tmp = path + ".fix"
+            out = zipfile.ZipFile(tmp, "w", zipfile.ZIP_DEFLATED)
+            for info, data in items:
+                ni = zipfile.ZipInfo(info.filename, date_time=info.date_time)
+                ni.compress_type = zipfile.ZIP_DEFLATED
+                ni.external_attr = info.external_attr
+                out.writestr(ni, data)
+            out.close()
+            src.close()
+            os.replace(tmp, path)
+            src = zipfile.ZipFile(path)
+
+        # Verificacion: ninguna parte puede citar un r:id que su .rels no declare.
+        nombres = set(src.namelist())
+        for name in sorted(nombres):
+            if name.endswith(".rels") or not name.endswith(".xml"):
+                continue
+            try:
+                xml = src.read(name).decode("utf-8", "replace")
+            except Exception:                                 # noqa: BLE001
+                continue
+            usados = set(re.findall(r"r:(?:id|embed)=\"([^\"]+)\"", xml))
+            if not usados:
+                continue
+            rels = posixpath.join(posixpath.dirname(name), "_rels",
+                                  posixpath.basename(name) + ".rels")
+            declarados = set()
+            if rels in nombres:
+                declarados = set(re.findall(
+                    r"Id=\"([^\"]+)\"", src.read(rels).decode("utf-8", "replace")))
+            faltan = sorted(usados - declarados)
+            if faltan:
+                pendientes.append(
+                    "%s cita %s y su .rels no lo declara" % (name, ", ".join(faltan)))
+    finally:
+        try:
+            src.close()
+        except Exception:                                     # noqa: BLE001
+            pass
+
+    return arreglos, pendientes
+
+
+def save_workbook(wb, path):
+    """Guarda el libro y deja el paquete integro, que es lo que Excel exige para abrirlo.
+
+    Todo guardado de esta herramienta pasa por aqui: un `wb.save()` suelto vuelve a dejar el
+    archivo con el aviso de contenido ilegible, y eso no se ve hasta que alguien lo abre.
+    """
+    wb.save(path)
+    return repair_package(path)
+
+
+def report_package(arreglos, pendientes):
+    """Imprime lo que la reparacion toco y lo que no pudo dejar bien."""
+    for line in arreglos:
+        print("  ~", line)
+    for line in pendientes:
+        print("AVISO  %s" % line)
+    if pendientes:
+        print("       Excel puede avisar de contenido ilegible al abrir la planilla.")
+
+
